resource "aws_s3_bucket" "logs" {
  # checkov:skip=CKV_AWS_18:access logging is the logs bucket itself
  bucket = "f16-fixture-logs"
}

resource "aws_security_group" "web" {
  name = "f16-fixture-web"
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }
}
